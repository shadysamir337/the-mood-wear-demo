# Firebase web app config (Firebase console → Project settings → Your apps).
# Leave empty to run the browser-only DEMO MODE (dev and preview only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional
VITE_FIREBASE_APPCHECK_KEY=          # reCAPTCHA Enterprise site key for App Check
VITE_FIREBASE_EMULATORS=             # 1 = talk to local emulators
VITE_ALLOW_DEMO=                     # 1 = allow demo mode in a production build (preview links)
VITE_SITE_URL=https://themood.co     # used for canonical/OG URLs and the sitemap
VITE_GA_ID=                          # Google Analytics 4 measurement ID
VITE_META_PIXEL_ID=                  # Meta (Facebook/Instagram) Pixel
VITE_TIKTOK_PIXEL_ID=                # TikTok Pixel
