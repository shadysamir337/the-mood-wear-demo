rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.role in ['owner', 'admin']; }

    // Product and mood images: anyone can view, only admins upload (images under 8 MB).
    match /uploads/{path=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
